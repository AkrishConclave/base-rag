# Development Environment Configuration
# Скопируйте этот файл в api/.env и заполните значения

# OpenRouter API
OPENROUTER_API_KEY=sk-or-v1-your-dev-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_FALLBACK_MODELS=openai/gpt-3.5-turbo,anthropic/claude-3-haiku

# ChromaDB
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION_NAME=support_articles

# Embedding Model
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Search Settings
TOP_K=10
MAX_DISTANCE=0.8

# LLM Provider
LLM_PROVIDER=openrouter

# Logging
LOG_LEVEL=DEBUG

# Caching
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_TYPE=sqlite

# Redis (не используется в dev, если CACHE_TYPE=sqlite)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

