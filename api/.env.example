# Yandex AI Studio (create api/.env from this file; never commit real values)
YANDEX_CLOUD_FOLDER=your-folder-id
YANDEX_CLOUD_API_KEY=your-api-key
YANDEX_CLOUD_MODEL=deepseek-v4-flash/latest
YANDEX_CLOUD_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_CLOUD_TEMPERATURE=0.3
YANDEX_CLOUD_MAX_OUTPUT_TOKENS=65536

# RAG storage and retrieval
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION_NAME=support_articles
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
TOP_K=10
MAX_DISTANCE=0.8

# API access: replace both values with long random secrets
ADMIN_TOKEN=replace-with-a-long-random-value
JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256

# Runtime
LLM_PROVIDER=yandex_ai_studio
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_TYPE=sqlite
