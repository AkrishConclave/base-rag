    {
      "name": "Debug",
      "item": [
        {
          "name": "Debug Search (Векторный)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"q\": \"оповещения\",\n    \"top_k\": 5,\n    \"use_hybrid\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/debug/search",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "debug",
                "search"
              ]
            },
            "description": "Отладочный поиск с детальной информацией о результатах. Показывает rank, title, distance, preview для каждого результата. По умолчанию показывает только публичные статьи (status=1). Используйте admin_mode: true для админки (все статьи)."
          },
          "response": []
        },
        {
          "name": "Debug Search (Гибридный)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"q\": \"оповещения\",\n    \"top_k\": 5,\n    \"use_hybrid\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/debug/search",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "debug",
                "search"
              ]
            },
            "description": "Отладочный гибридный поиск с детальной информацией о результатах."
          },
          "response": []
        },
        {
          "name": "Check Article IDs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"start_id\": 1000,\n    \"end_id\": 1009\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/debug/check-ids",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "debug",
                "check-ids"
              ]
            },
            "description": "Проверяет наличие записей с article_id в указанном диапазоне. Полезно для проверки индексации конкретных статей."
          },
          "response": []
        },
        {
          "name": "Clear Index",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/debug/clear-index",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "debug",
                "clear-index"
              ]
            },
            "description": "Очищает все данные из ChromaDB индекса (удаляет коллекцию). После очистки необходимо выполнить индексацию через /api/ingest. Возвращает количество удаленных записей."
          },
          "response": []
        },
        {
          "name": "Clear Cache",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/debug/clear-cache",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "debug",
                "clear-cache"
              ]
            },
            "description": "Очищает весь кэш запросов LLM. Работает с SQLite и Redis. Полезно для сброса кэша при обновлении данных или для тестирования."
          },
          "response": []
        },
        {
          "name": "Test LLM Connection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"query\": \"как настроить оповещения\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/debug/test-llm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "debug",
                "test-llm"
              ]
            },
            "description": "Проверяет соединение с LLM для расширения поисковых запросов. Тестирует функцию expand_query_with_llm и возвращает время ответа, расширенный запрос и информацию о провайдере."
          },
          "response": []
        }
