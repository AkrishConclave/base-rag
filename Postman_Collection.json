{
  "info": {
    "_postman_id": "rag-support-api-v2",
    "name": "RAG Support API v2.0",
    "description": "Коллекция для тестирования RAG-системы поддержки Support с новыми возможностями: гибридный поиск, кэширование, debug endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "item": [
    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Проверка состояния API и ChromaDB. Используется для мониторинга и load balancer."
          },
          "response": []
        }
      ],
      "description": "Эндпоинты для проверки состояния системы"
    },
    {
      "name": "Ingest",
      "item": [
        {
          "name": "Индексация данных (API)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ingest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ingest"
              ]
            },
            "description": "Индексирует статьи из JSON файла в векторную базу данных ChromaDB. Индексируются статьи со статусом 0 (для staff) и статусом 1 (для клиентов). Выполните этот запрос перед первым использованием системы."
          },
          "response": []
        }
      ],
      "description": "Эндпоинты для индексации данных. Индексируются статьи со статусом 0 (для staff) и статусом 1 (для клиентов)."
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "Загрузить файл support_*.json",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "JSON файл, начинающийся с support_"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/upload-support",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "upload-support"
              ]
            },
            "description": "Загружает новый файл support_*.json. Старый файл автоматически переименовывается с добавлением *old* в название (например, support_202511221211.json -> support_202511221211*old*.json). После загрузки необходимо выполнить индексацию через /api/ingest."
          },
          "response": []
        },
        {
          "name": "Скачать текущий файл support_*.json",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/download-support",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "download-support"
              ]
            },
            "description": "Скачивает текущий файл support_*.json, который используется для индексации. Полезно для просмотра или редактирования файла перед загрузкой новой версии."
          },
          "response": []
        }
      ],
      "description": "Эндпоинты для загрузки и управления файлами support_*.json"
    },
    {
      "name": "RAG - Поиск и ответы",
      "item": [
        {
          "name": "Ask Question (Векторный поиск)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"q\": \"Как настроить оповещения?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/ask",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ask"
              ]
            },
            "description": "Публичная справка для клиентов. По умолчанию показывает только публичные статьи (status=1). Используйте admin_mode: true для админки (все статьи)."
          },
          "response": []
        },
