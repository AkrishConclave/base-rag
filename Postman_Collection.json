{
  "info": {
    "_postman_id": "rag-support-api-v2",
    "name": "RAG Support API v2.0",
    "description": "Коллекция для тестирования RAG-системы поддержки Support с новыми возможностями: гибридный поиск, кэширование, debug endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "item": [
    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Проверка состояния API и ChromaDB. Используется для мониторинга и load balancer."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"API сообщает healthy\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(\"healthy\");",
                  "    pm.expect(body).to.have.property(\"chroma_db\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ],
      "description": "Эндпоинты для проверки состояния системы"
    },
    {
      "name": "Ingest",
      "item": [
        {
          "name": "Индексация данных (API)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ingest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ingest"
              ]
            },
            "description": "Индексирует статьи из JSON файла в векторную базу данных ChromaDB. Индексируются статьи со статусом 0 (для staff) и статусом 1 (для клиентов). Выполните этот запрос перед первым использованием системы."
          },
          "response": []
        }
      ],
      "description": "Эндпоинты для индексации данных. Индексируются статьи со статусом 0 (для staff) и статусом 1 (для клиентов)."
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "Загрузить файл support_*.json",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
              "description": "Выберите конкретный JSON-файл support_<timestamp>.json. Папку выбирать нельзя; путь намеренно не хранится в коллекции."
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/upload-support",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "upload-support"
              ]
            },
            "description": "Загружает новый файл support_*.json, не переименовывая и не удаляя предыдущие экспорты. В Body → form-data → file выберите конкретный JSON-файл, не каталог. Используйте timestamp в имени, например support_202511221211.json: индексация выберет самый новый timestamp. После загрузки выполните /api/ingest."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Файл сохранён без переименования старых экспортов\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.message).to.eql(\"Файл успешно загружен\");",
                  "    pm.expect(body.size_bytes).to.be.above(0);",
                  "    pm.expect(body.old_file_renamed).to.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Скачать текущий файл support_*.json",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/download-support",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "download-support"
              ]
            },
            "description": "Скачивает текущий файл support_*.json, который используется для индексации. Полезно для просмотра или редактирования файла перед загрузкой новой версии."
          },
          "response": []
        }
      ],
      "description": "Эндпоинты для загрузки и управления файлами support_*.json"
    },
