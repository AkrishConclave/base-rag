FROM python:3.12-slim

WORKDIR /app

# Устанавливаем системные зависимости для сборки пакетов
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Удаляем build-essential после установки зависимостей для уменьшения размера образа
RUN apt-get update && apt-get purge -y --auto-remove \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Копируем api/ в /app/api/, чтобы импорты from api.* работали
COPY api/ /app/api/

# Устанавливаем PYTHONPATH для корректной работы импортов
ENV PYTHONPATH=/app

# Запускаем через uvicorn напрямую
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "9001"]
